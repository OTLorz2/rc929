        <mxCell id="ov_teach" value="&lt;b&gt;Summary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Like nested project breakdowns.&lt;br&gt;&lt;br&gt;Validate locally, recurse children, then validate globally. &lt;code&gt;task_execution.py:175&lt;/code&gt;&lt;br&gt;&lt;br&gt;Depth increases only after a valid child plan is saved." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F7F7F2;strokeColor=#6B6B6B;fontColor=#1A1A1A;fontSize=13;" vertex="1" parent="1">
