        <mxCell id="ov_summary" value="&lt;b&gt;要点 / Key findings&lt;/b&gt;&lt;br&gt;1. Ingest is a short linear conceptual spine.&lt;br&gt;&lt;code&gt;ingest/handler.py:20-95&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F7F7F2;strokeColor=#6B6B6B;fontColor=#1A1A1A;fontSize=13;" vertex="1" parent="1">
