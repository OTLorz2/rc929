        <mxCell id="fl_impl" value="&lt;b&gt;Impl map&lt;/b&gt;&lt;br&gt;S1 → ingest/handler.py:20-35&lt;br&gt;S2 → ingest/normalize.py:10-40&lt;br&gt;S3 → ingest/store.py:50-70&lt;br&gt;S4 → ingest/handler.py:80-95" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fl_note" value="&lt;b&gt;Summary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Like a mailroom: open the letter, rewrite the address cleanly, file it, then stamp received.&lt;br&gt;&lt;br&gt;An event is received, normalized, persisted, then acknowledged. See Impl map for &lt;code&gt;ingest/handler.py:20&lt;/code&gt;.&lt;br&gt;&lt;br&gt;Acknowledgement must follow durable persist so retries stay safe." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F7F7F2;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
